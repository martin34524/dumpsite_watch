<Layouts.app flash={@flash}>
  <header class="border-b border-[#e4e9e4] bg-white">
    <div class="mx-auto flex max-w-[1480px] items-center justify-between px-5 py-4 sm:px-8">
      <a href="/" class="flex items-center gap-3" aria-label="Dumpsite Watch home">
        <span class="grid size-10 place-items-center rounded-xl bg-[#173c32] text-[#c9ef78]"><.icon
          name="hero-globe-asia-australia"
          class="size-6"
        /></span>
        <span><span class="block text-sm font-bold tracking-tight">Dumpsite Watch</span><span class="block text-xs text-[#758179]">County operations</span></span>
      </a>
      <div class="flex items-center gap-3">
        <span class="rounded-full border border-[#dce6dd] bg-[#f5f8f4] px-3 py-1.5 text-xs font-semibold text-[#42614d]">Live pilot workspace</span>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-[1480px] px-5 py-8 sm:px-8 sm:py-10">
    <section class="mb-8 flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-[#648071]">
          Field intelligence · {@county} County
        </p>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Pilot evidence workspace
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-[#68766e]">
          Explore published river-study observations and their locations. These are unreviewed leads, not mapped or confirmed dumpsite footprints.
        </p>
      </div>
      <div class="flex items-center gap-3 self-start rounded-xl border border-[#e1e7e1] bg-white px-4 py-3 lg:self-auto">
        <span class="grid size-9 place-items-center rounded-lg bg-[#edf3eb] text-[#41634f]"><.icon
          name="hero-map-pin"
          class="size-5"
        /></span>
        <span><span class="block text-sm font-semibold">{@county} County</span><span class="block text-xs text-[#87928b]">Pilot boundary loaded</span></span>
      </div>
    </section>

    <section aria-label="Pilot data summary" class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-2xl border border-[#e5eae5] bg-white p-5">
        <div class="flex items-center justify-between text-sm text-[#718077]">
          <span>Study leads</span><.icon name="hero-map-pin" class="size-5" />
        </div><p class="mt-5 text-3xl font-semibold">{@lead_count}</p><p class="mt-1 text-xs text-[#87928b]">
          All are unreviewed
        </p>
      </div>
      <div class="rounded-2xl border border-[#e5eae5] bg-white p-5">
        <div class="flex items-center justify-between text-sm text-[#718077]">
          <span>Source observations</span><.icon name="hero-document-text" class="size-5" />
        </div><p class="mt-5 text-3xl font-semibold">2021</p><p class="mt-1 text-xs text-[#87928b]">
          Ngong River field study
        </p>
      </div>
      <div class="rounded-2xl border border-[#e5eae5] bg-white p-5">
        <div class="flex items-center justify-between text-sm text-[#718077]">
          <span>Boundary</span><.icon name="hero-square-3-stack-3d" class="size-5" />
        </div><p class="mt-5 text-xl font-semibold">Ready to use</p><p class="mt-1 text-xs text-[#87928b]">
          {@boundary_source} · EPSG:4326
        </p>
      </div>
      <div class="rounded-2xl border border-[#e5eae5] bg-white p-5">
        <div class="flex items-center justify-between text-sm text-[#718077]">
          <span>Satellite catalog</span><span class="size-2 rounded-full bg-[#d99b47]"></span>
        </div><p class="mt-5 text-xl font-semibold">Not connected</p><p class="mt-1 text-xs text-[#87928b]">
          Catalog request needs network access
        </p>
      </div>
    </section>

    <section class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.45fr)_minmax(380px,0.85fr)]">
      <article class="overflow-hidden rounded-2xl border border-[#e5eae5] bg-white">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#edf0ed] px-5 py-4 sm:px-6">
          <div>
            <h2 class="font-semibold">Nairobi study area</h2><p class="mt-1 text-xs text-[#87928b]">
              Select a point to inspect its source evidence
            </p>
          </div>
          <span class="rounded-full bg-[#fff4e8] px-3 py-1.5 text-xs font-semibold text-[#976431]">Unreviewed evidence</span>
        </div>
        <div id="pilot-map" class="relative aspect-[3/2] w-full overflow-hidden bg-[#eef3ed]">
          <svg
            viewBox="0 0 960 640"
            preserveAspectRatio="xMidYMid meet"
            class="absolute inset-0 size-full"
            role="img"
            aria-labelledby="map-title map-description"
          >
            <title id="map-title">Nairobi County study leads</title>
            <desc id="map-description">
              County boundary and {@lead_count} selectable sampling points from a 2021 river study. These are not dump footprints.
            </desc>
            <rect width="960" height="640" fill="#eef3ed" />
            <path
              d={@boundary_path}
              fill="#c9d8cd"
              fill-rule="evenodd"
              stroke="#6d8977"
              stroke-width="2.2"
              stroke-linejoin="round"
            />
            <g>
              <a
                :for={lead <- @filtered_leads}
                href="#selected-lead"
                phx-click="select_lead"
                phx-value-id={lead["id"]}
                aria-label={"Select " <> lead["name"]}
              >
                <circle
                  cx={lead["map_x"]}
                  cy={lead["map_y"]}
                  r={if lead["id"] == @selected_id, do: "10", else: "7"}
                  fill={if lead["id"] == @selected_id, do: "#173c32", else: "#d35d42"}
                  stroke="#fffdf8"
                  stroke-width="2.5"
                >
                  <title>{lead["name"]} · unreviewed study sampling point</title>
                </circle>
              </a>
            </g>
            <text x="30" y="42" fill="#53675b" font-size="16" font-family="system-ui,sans-serif">
              Nairobi County · simplified boundary
            </text>
            <text x="30" y="612" fill="#53675b" font-size="14" font-family="system-ui,sans-serif">
              Points show 2021 water-sampling locations, not dumpsite footprints
            </text>
          </svg>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[#edf0ed] px-5 py-3 sm:px-6">
          <p class="text-xs text-[#718077]">
            Showing {@filtered_leads |> length()} of {@lead_count} leads
          </p>
          <div class="flex items-center gap-2 text-xs text-[#718077]">
            <span class="size-2.5 rounded-full bg-[#d35d42]"></span>Reported dumping observation <span class="ml-2 size-2.5 rounded-full bg-[#173c32]"></span>Selected point
          </div>
        </div>
      </article>

      <div class="space-y-6">
        <article class="overflow-hidden rounded-2xl border border-[#e5eae5] bg-white">
          <div class="border-b border-[#edf0ed] px-5 py-4 sm:px-6">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="font-semibold">Reference observations</h2><p class="mt-1 text-xs text-[#87928b]">
                  Search and filter published field notes
                </p>
              </div><span class="text-xs font-semibold text-[#976431]">Unreviewed</span>
            </div>
            <.form for={@search_form} id="lead-search" phx-change="search" class="mt-4">
              <label for={@search_form[:query].id} class="sr-only">Search reference observations</label>
              <div class="relative">
                <.input
                  field={@search_form[:query]}
                  type="search"
                  placeholder="Search location or evidence"
                  autocomplete="off"
                  class="w-full rounded-xl border border-[#dfe6df] bg-[#fbfcfa] py-3 pl-10 pr-10 text-sm text-[#24342b] outline-none transition focus:border-[#718f78] focus:ring-2 focus:ring-[#dce9da]"
                />
                <.icon
                  name="hero-magnifying-glass"
                  class="pointer-events-none absolute left-3 top-3.5 size-4 text-[#87928b]"
                />
                <button
                  :if={@query != ""}
                  type="button"
                  phx-click="clear_search"
                  aria-label="Clear search"
                  class="absolute right-3 top-3.5 text-[#87928b] hover:text-[#173c32]"
                ><.icon name="hero-x-mark" class="size-4" /></button>
              </div>
            </.form>
            <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter observations">
              <button
                :for={{key, label} <- @filter_options}
                type="button"
                phx-click="filter"
                phx-value-filter={key}
                aria-pressed={@filter == key}
                class={[
                  "rounded-full px-3 py-1.5 text-xs font-semibold transition",
                  if(@filter == key,
                    do: "bg-[#173c32] text-white",
                    else: "bg-[#f1f4f1] text-[#647269] hover:bg-[#e8eee7]"
                  )
                ]}
              >{label}</button>
            </div>
          </div>
          <div class="max-h-[440px] divide-y divide-[#edf0ed] overflow-y-auto">
            <button
              :for={lead <- @filtered_leads}
              type="button"
              phx-click="select_lead"
              phx-value-id={lead["id"]}
              aria-pressed={lead["id"] == @selected_id}
              class={[
                "flex w-full items-center justify-between gap-3 px-5 py-3 text-left transition sm:px-6",
                if(lead["id"] == @selected_id,
                  do: "bg-[#f1f6ef]",
                  else: "bg-white hover:bg-[#fafbf9]"
                )
              ]}
            >
              <span class="min-w-0"><span class="block truncate text-sm font-semibold text-[#24342b]">{lead[
                "name"
              ]}</span><span class="mt-1 block truncate text-xs text-[#87928b]">{lead["latitude"]
              |> abs()
              |> Float.round(6)}° S · {Float.round(lead["longitude"], 6)}° E</span></span>
              <span class="shrink-0 rounded-full bg-[#fff4e8] px-2.5 py-1 text-[10px] font-semibold text-[#976431]">Review</span>
            </button>
            <div :if={@filtered_leads == []} class="px-6 py-10 text-center">
              <.icon name="hero-magnifying-glass" class="mx-auto size-6 text-[#9aa69d]" /><p class="mt-3 text-sm font-semibold">
                No matching observations
              </p><p class="mt-1 text-xs text-[#87928b]">Try another location or filter.</p>
            </div>
          </div>
        </article>

        <article
          id="selected-lead"
          class="rounded-2xl border border-[#dfe8de] bg-white p-5 sm:p-6"
        >
          <div :if={@selected_lead}>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-[#648071]">
                  Selected evidence lead
                </p><h2 class="mt-2 text-xl font-semibold tracking-tight">
                  {@selected_lead["name"]}
                </h2>
              </div><span class="shrink-0 rounded-full bg-[#fff4e8] px-3 py-1.5 text-xs font-semibold text-[#976431]">Unreviewed</span>
            </div>
            <p class="mt-4 text-sm leading-6 text-[#68766e]">
              {@selected_lead["evidence_notes"]}
            </p>
            <dl class="mt-5 grid grid-cols-2 gap-3 rounded-xl bg-[#f6f8f5] p-4 text-sm">
              <div>
                <dt class="text-xs text-[#87928b]">Latitude</dt><dd class="mt-1 font-medium">
                  {Float.round(@selected_lead["latitude"], 6)}
                </dd>
              </div>
              <div>
                <dt class="text-xs text-[#87928b]">Longitude</dt><dd class="mt-1 font-medium">
                  {Float.round(@selected_lead["longitude"], 6)}
                </dd>
              </div>
              <div>
                <dt class="text-xs text-[#87928b]">Observation period</dt><dd class="mt-1 font-medium">
                  {@selected_lead["study_period"]}
                </dd>
              </div>
              <div>
                <dt class="text-xs text-[#87928b]">Review state</dt><dd class="mt-1 font-medium">
                  Not reviewed
                </dd>
              </div>
            </dl>
            <a
              href={@selected_lead["source_url"]}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[#315d49] hover:text-[#173c32]"
            >Read the source study <.icon name="hero-arrow-top-right-on-square" class="size-4" /></a>
          </div>
          <div :if={is_nil(@selected_lead)} class="py-4 text-sm text-[#718077]">
            Select a point or clear the current filter to inspect a source record.
          </div>
        </article>
      </div>
    </section>

    <section class="mt-6 flex flex-col gap-4 rounded-2xl border border-[#dfe8de] bg-[#edf3eb] p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div class="flex gap-4">
        <span class="hidden size-10 shrink-0 place-items-center rounded-xl bg-white text-[#53725d] sm:grid"><.icon
          name="hero-information-circle"
          class="size-5"
        /></span><div>
          <h2 class="text-sm font-semibold">Evidence limits</h2><p class="mt-1 max-w-3xl text-sm leading-6 text-[#6f7e72]">
            The study reports 2021 river-sampling observations. Its coordinates are sampling locations, not dumpsite outlines, and current conditions are unknown. Satellite candidates and field review are needed before a site can be confirmed or ranked.
          </p>
        </div>
      </div>
      <a
        href="https://www.mdpi.com/2073-4441/15/4/660"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-lg border border-[#d5dfd4] bg-white/70 px-3 py-2 text-xs font-semibold text-[#42614d] hover:bg-white"
      >Open study source</a>
    </section>

    <footer class="py-8 text-center text-xs text-[#98a29b]">
      Dumpsite Watch · Nairobi pilot · Source-backed leads, not confirmed detections
    </footer>
  </main>
</Layouts.app>
